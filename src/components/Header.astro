---
import HeaderFooterLink from "./HeaderFooterLink.astro";
import Logo from "./Logo.astro";
import ThemeToggleBtn from "./ThemeToggleBtn.astro";

const { pathname } = Astro.url;
const isHome = pathname === "/" || pathname === "";
---

<header
  class="container flex items-center justify-between gap-2 py-5 md:py-10 lg:py-16"
>
  <a
    class="transition-colors duration-500 hover:text-primary focus:text-primary"
    href="/"
    data-logo-active={isHome}
  >
    <Logo />
  </a>
  <nav class="flex items-center gap-3 sm:gap-6 md:gap-8 lg:gap-12">
    <!-- <HeaderFooterLink href="/">Projects</HeaderFooterLink> -->
    <HeaderFooterLink href="/">About</HeaderFooterLink>
    <HeaderFooterLink href="/contact">Contact</HeaderFooterLink>
    <ThemeToggleBtn />
  </nav>
</header>

<script>
  function preventLogoNavigation() {
    const logo = document.querySelector<HTMLAnchorElement>('a[data-logo-active="true"]');

    if (logo) {
      // Clone and replace to remove old listeners
      const newLogo = logo.cloneNode(true) as HTMLAnchorElement;
      logo.parentNode?.replaceChild(newLogo, logo);

      newLogo.addEventListener('click', (e) => {
        e.preventDefault();
      });
    }
  }

  // Run on initial load
  preventLogoNavigation();

  // Re-run after view transitions
  document.addEventListener('astro:page-load', preventLogoNavigation);
</script>

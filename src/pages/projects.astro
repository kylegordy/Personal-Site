---
import SiteLayout from "../layouts/SiteLayout.astro";
import Triangle from "../components/Triangle.astro";
import CTALink from "../components/CTALink.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import { CHAT_BOOKING_URL } from "../config";
---

<SiteLayout title="UI Designer & Frontend Developer">
  <main>
    <!-- Hero -->
    <section
      class="container grid items-center gap-[var(--container-padding)] pb-[calc(var(--container-padding)*1.5)] lg:grid-cols-[1fr_40%] lg:py-0"
    >
      <div>
        <h2 class="mb-4 text-3xl font-bold lg:mb-7">
          I design hard-working websites & apps.
        </h2>
        <p class="text-muted text-base lg:mb-7">
          Hi, I’m Kyle 👋 I'm a multifaceted UI Designer / Frontend Developer
          with 10+ years of experience. I’m passionate about building effective,
          impactful, and accessible products folks enjoy using.
        </p>
        <CTALink href="/" icon="arrow-right">Read More</CTALink>
      </div>

      <!-- Moody Portrait -->
      <div
        class="outline-border relative z-10 order-first max-w-[250px] overflow-hidden rounded-4xl rounded-br-none outline-1 outline-offset-[-1px] lg:order-none lg:max-w-[500px] lg:place-self-end"
      >
        <img
          class="relative z-10"
          src="https://res.cloudinary.com/drl4zairb/image/upload/w_500,h_750,c_fill,g_face,q_auto:eco,f_auto,dpr_1/v1679294928/moody-portrait-v2_epbe4v.png"
          srcset="
          https://res.cloudinary.com/drl4zairb/image/upload/w_500,h_750,c_fill,g_face,q_auto:eco,f_auto,dpr_1/v1679294928/moody-portrait-v2_epbe4v.png,
          https://res.cloudinary.com/drl4zairb/image/upload/w_500,h_750,c_fill,g_face,q_auto:eco,f_auto,dpr_2/v1679294928/moody-portrait-v2_epbe4v.png 2x
        "
          width="500"
          height="750"
          alt="Moody black and white portrait of Kyle Gordy"
          loading="lazy"
        />

        <Triangle
          class="text-primary absolute right-0 bottom-0 z-0 [--size:min(35vw,650px)]"
        />

        <Triangle
          class="text-primary absolute right-0 bottom-0 z-20 [--size:min(15vw,80px)]"
        />
      </div>
    </section>

    <!-- Featured Projects -->
    <FeaturedProjects />

    <!-- Help CTA -->
    <section
      class="container py-[calc(var(--container-padding)*2)] md:py-[var(--container-padding)]"
    >
      <h2 class="mb-3 text-2xl font-bold md:mb-4">Need help with a project?</h2>
      <p class="text-muted mb-4 max-w-2xl text-base md:mb-6">
        I’m currently looking for new ones and would love to learn more about
        yours. I’m comfortable working alone or alongside your team.
      </p>
      <CTALink href="/contact" icon="arrow-right">Reach Out</CTALink>
    </section>
  </main>
</SiteLayout>
